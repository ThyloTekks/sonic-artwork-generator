{
  "name": "Sonic Artwork",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "sonic_artwork.py"]
    },
    "vscode": {
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      },
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "sudo apt update && sudo xargs apt install -y <packages.txt && pip3 install --user -r requirements-dev.txt && echo '✅ Pakete installiert'",
  "postAttachCommand": {
    "server": "streamlit run sonic_artwork.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": { "label": "Application", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8501]
}
